{
  "name": "chathelp-private-cloud-unconfigured",
  "main": "./cloudflare/worker/src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "secrets": {
    "required": ["ACCESS_TEAM_DOMAIN", "ACCESS_AUD_TESTING", "ACCESS_AUD_PRODUCTION", "ANTHROPIC_API_KEY"]
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "DRAFT_RATE_LIMITER",
      "namespace_id": "7493101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "env": {
    "testing": {
      "name": "testing-chathelp-private-cloud",
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "testing"
      },
      "ai": {
        "binding": "AI"
      },
      "secrets": {
        "required": ["ACCESS_TEAM_DOMAIN", "ACCESS_AUD_TESTING", "ACCESS_AUD_PRODUCTION", "ANTHROPIC_API_KEY"]
      },
      "hyperdrive": [
        {
          "binding": "NEON_TESTING",
          "id": "69eb149ad82d40cba7e729279294d521"
        }
      ],
      "ratelimits": [
        {
          "name": "DRAFT_RATE_LIMITER",
          "namespace_id": "7493101",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    },
    "production": {
      "name": "chathelp-private-cloud",
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "production"
      },
      "ai": {
        "binding": "AI"
      },
      "secrets": {
        "required": ["ACCESS_TEAM_DOMAIN", "ACCESS_AUD_TESTING", "ACCESS_AUD_PRODUCTION", "ANTHROPIC_API_KEY"]
      },
      "hyperdrive": [
        {
          "binding": "NEON_PRODUCTION",
          "id": "0df56a4e086547eb9e15d1d964556676"
        }
      ],
      "ratelimits": [
        {
          "name": "DRAFT_RATE_LIMITER",
          "namespace_id": "7493101",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
