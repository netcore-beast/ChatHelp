{
  "manifest_version": 3,
  "name": "ChatHelp LinkedIn Conversation Reader",
  "description": "With your permission, reads only the visible LinkedIn conversation you manually open and hands it to your encrypted local ChatHelp vault. It never scans or sends.",
  "version": "0.4.1",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Capture the open LinkedIn conversation for ChatHelp"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chathelp-private-cloud.project-mission-ai.workers.dev/*",
    "https://testing-chathelp-private-cloud.project-mission-ai.workers.dev/*"
  ],
  "optional_host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chathelp-private-cloud.project-mission-ai.workers.dev/*",
        "https://testing-chathelp-private-cloud.project-mission-ai.workers.dev/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
