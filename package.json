{
  "name": "chathelp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:live-csp": "node scripts/verify-live-csp.mjs",
    "verify:static-csp": "node scripts/verify-static-csp.mjs",
    "verify:browser": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron scripts/browser-smoke.cjs",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "postinstall": "npm run prepare:ocr && npm run prepare:icons",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "build:native": "cross-env CHATHELP_NATIVE_BUILD=1 next build && node scripts/inject-static-csp.mjs",
    "desktop:dir": "npm run build:native && electron-builder --dir --config electron-builder.yml",
    "package:windows": "npm run build:native && electron-builder --win nsis portable --x64 --config electron-builder.yml",
    "android:sync": "npm run build:native && cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "8.4.2",
    "@mlc-ai/web-llm": "0.2.84",
    "@tesseract.js-data/eng": "^1.0.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "minimatch": "10.2.4"
  },
  "main": "desktop/main.cjs"
}
